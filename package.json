{
  "name": "@yu1745/dsh-agy-acp",
  "version": "1.0.8",
  "description": "独立的 DSH Antigravity ACP bundle",
  "type": "module",
  "license": "MIT",
  "author": "yu1745",
  "repository": { "type": "git", "url": "git+https://github.com/yu1745/dsh-agy-acp.git" },
  "packageManager": "pnpm@11.5.1",
  "engines": { "node": ">=22", "dsh": "^0.2.2-rc.3" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE.md"],
  "main": "./lib/google-acp.js",
  "exports": {
    ".": "./lib/google-acp.js",
    "./client": "./lib/client.js",
    "./google-acp": "./lib/google-acp.js",
    "./google-acp-models": "./lib/google-acp-models.js",
    "./google-acp-state": "./lib/google-acp-state.js",
    "./google-acp-session": "./lib/google-acp-session.js",
    "./google-acp-usage": "./lib/google-acp-usage.js",
    "./google-acp-compact": "./lib/google-acp-compact.js",
    "./google-acp-compaction": "./lib/google-acp-compaction.js",
    "./google-acp-records": "./lib/google-acp-records.js",
    "./google-acp-rpc": "./lib/google-acp-rpc.js",
    "./google-acp-mcp": "./lib/google-acp-mcp.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": ["./cordis.patch.yml"] },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat"],
      "platform": "web"
    }
  },
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test tests/*.test.mjs", "check": "pnpm run build && pnpm test" },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-command-compact": "^0.2.2-rc.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-rc.3",
    "@types/react": "^18.3.0",
    "react": "18.3.1",
    "esbuild": "0.28.2"
  }
}
